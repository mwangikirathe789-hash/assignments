#include <iostream>
using namespace std;

int factorial(int n) {
    if (n == 0 || n == 1)
        return 1;
    else
        return n * factorial(n - 1);
}

int main() {
    int n;

    cout << "Enter a number: ";
    cin >> n;

    cout << "Factorial = " << factorial(n);

    return 0;
}


C.Program to Find the Nth Term of a Fibonacci Series


#include <iostream>
using namespace std;

int fibonacci(int n) {
    if (n == 0)
        return 0;
    else if (n == 1)
        return 1;
    else
        return fibonacci(n - 1) +
               fibonacci(n - 2);
}

int main() {
    int n;

    cout << "Enter the term number: ";
    cin >> n;

    cout << "Fibonacci term = "
         << fibonacci(n);

    return 0;
}


